[Unit]
Description=Muli page retention shadow check (no page deletion)
ConditionPathExists=%h/.config/muli-archive/snapshot-maintenance.json

[Service]
Type=oneshot
EnvironmentFile=%h/.config/muli-archive/snapshot-maintenance.env
ExecStart=/usr/bin/python3 %h/.local/share/muli-archive-maintenance/current.pyz --config %h/.config/muli-archive/snapshot-maintenance.json shadow --execute --confirmed-policy ${MULI_SNAPSHOT_POLICY_SHA256}
TimeoutStartSec=90
UMask=0077
